{
  "name": "@danixts/sileo-vue",
  "version": "0.2.0",
  "description": "Physics-based toast notifications for Vue 3, inspired by Sileo.",
  "keywords": [
    "vue",
    "vue3",
    "toast",
    "notification",
    "animation",
    "gradient"
  ],
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danixts/sileo-vue.git"
  },
  "homepage": "https://danixts.github.io/sileo-vue/",
  "bugs": {
    "url": "https://github.com/danixts/sileo-vue/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "scripts": {
    "build": "pnpm clean && vue-tsc -p tsconfig.build.json && vite build",
    "clean": "rm -rf dist coverage",
    "dev": "vite build --watch",
    "lint": "eslint src tests scripts site eslint.config.js vite.config.ts vitest.config.ts",
    "format": "prettier --write src tests scripts site README.md THIRD_PARTY_NOTICES.md package.json tsconfig.json tsconfig.build.json vite.config.ts vitest.config.ts",
    "format:check": "prettier --check src tests scripts site README.md THIRD_PARTY_NOTICES.md package.json tsconfig.json tsconfig.build.json vite.config.ts vitest.config.ts",
    "site": "astro dev --root site",
    "site:build": "astro check --root site && astro build --root site",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "vue-tsc --noEmit",
    "verify:package": "node scripts/verify-package.mjs",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "vue": ">=3.5.0 <4"
  },
  "dependencies": {
    "motion-v": "^2.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/vue": "^7.0.2",
    "@eslint/js": "^10.0.0",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@types/node": "^22.15.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "astro": "^7.2.2",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.9.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "vue": "3.5.41",
    "vue-tsc": "^3.3.9"
  }
}
